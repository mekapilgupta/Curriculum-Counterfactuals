# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Translation Model (Cost-effective, highly capable in Indic/Hindi translation)
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.0-flash-001

# Bilingual Concept Generation Model
OPENROUTER_CONCEPT_MODEL=google/gemini-2.0-flash-001

# Independent Dual LLM Judges
OPENROUTER_JUDGE_MODEL_A=google/gemini-2.0-flash-001
OPENROUTER_JUDGE_MODEL_B=qwen/qwen-2.5-72b-instruct
